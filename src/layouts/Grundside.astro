---
import '../styles/skrifter.css';
import '../styles/side.css';

interface Props {
  titel: string;
  beskrivelse: string;
}
const { titel, beskrivelse } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const delingsbillede = new URL(`${base}deling.png`, Astro.site);
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titel}</title>
    <meta name="description" content={beskrivelse} />
    <!-- Privat gave: søgemaskiner skal ikke finde siden. -->
    <meta name="robots" content="noindex, nofollow, noimageindex" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#f6efe6" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(base, Astro.site).href} />
    <meta property="og:locale" content="da_DK" />
    <meta property="og:title" content={titel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:image" content={delingsbillede.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="En lyserød kuvert med et hjerte: Til Sasja. Fra mig." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <script is:inline>
      document.documentElement.classList.add('js');
      var aabnet = false;
      try {
        aabnet = sessionStorage.getItem('gave-aabnet') === '1';
      } catch (e) {}
      if (!location.hash && !aabnet) document.documentElement.classList.add('kuvert-lukket');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
