<svg class:list={['tegning', `tegning--${motiv}`, klasse]} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  {
    motiv === 'paraply' && (
      <g>
        <path d="M9 31c2-11 11-19 23-19.5C44 11 53 19 56 30.5" />
