        <circle cx="32" cy="34" r="1.3" class="fyld" />
        <path d="M11 57h42" />
        <path d="M50 18l5-3M51.5 26h6M50 34l5 3" class="fart" />
      </g>
    )
  }
  {
    motiv === 'morgen' && (
      <g>
        <path d="M8 46h48" />
        <path d="M18 46a14 14 0 0 1 28 0" />
        <path d="M32 24v-7M18.5 30.5l-5-5M45.5 30.5l5-5M12 39H5M59 39h-7" class="fart" />
        <path d="M14 53h15M35 53h11" />
      </g>
    )
  }
  {
    motiv === 'skildpadde' && (
      <g>
        <path d="M11 41c1-12 10-21 21.5-21C44 20 52 29 52.5 41z" />
        <path d="M19 41c1.5-6.5 6.5-11 13-11s11.5 4.5 13 11M32 20v10M24 23.5l3 7.5M40.5 23.5l-3 7.5" />
        <path d="M52 37.5c3-3 8.5-2.5 8.5 1.5 0 3.5-4.5 4.5-8 2.5" />
        <path d="M17 41.5l-2 6M27 41.5l-1 6M38 41.5l1 6M47.5 41.5l2 5.5M11 41l-5 2" />
        <circle cx="57" cy="38.4" r=".9" class="fyld" />
