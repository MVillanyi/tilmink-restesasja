    )
  }
  {
    motiv === 'kram' && (
      <g>
        <path d="M24 50S8 40.5 8 29.5C8 24 12 20.5 16.5 20.5c3.5 0 6 2.2 7.5 4.5 1.5-2.3 4-4.5 7.5-4.5" />
