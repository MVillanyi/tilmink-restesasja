        <path d="M32.5 11.5V7.5" />
        <path d="M33 31.5v17c0 4.5-6 5-6.5.5" />
        <path d="M5 41h7M3.5 46.5h8M7 52h5" class="fart" />
      </g>
    )
  }
  {
    motiv === 'sverige' && (
      <g>
        <path d="M15 57V8" />
        <path d="M15.5 10.5c8-4 15 3.5 23 .5 4-1.5 7-3 11-2.5l-.5 23c-4-.5-7 1-11 2.5-8 3-15-4.5-22.5-.5" />
