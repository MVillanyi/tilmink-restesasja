---
// Små håndtegnede streger. Farven følger teksten omkring dem.
import type { Tegning as TegningNavn } from '../lib/typer';
interface Props {
  motiv: TegningNavn;
  class?: string;
}
const { motiv, class: klasse } = Astro.props;
