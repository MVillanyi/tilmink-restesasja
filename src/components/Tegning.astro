      </g>
    )
  }
  {
    motiv === 'hjerte' && (
      <path class="fyld" d="M32 54S9 40 9 24.5C9 17 14.5 12 21 12c5 0 8.8 3 11 6.5C34.2 15 38 12 43 12c6.5 0 12 5 12 12.5C55 40 32 54 32 54z" />
    )
  }
</svg>
