---
import { indhold } from '../indhold';
import Foto from './Foto.astro';
import Linjer from './Linjer.astro';
const b = indhold.brev;
const afsnit = b.tekst
  .trim()
  .split(/\n\s*\n/)
  .map((a) => a.trim())
  .filter(Boolean);
const visUdkast = import.meta.env.DEV && !b.godkendt;
---

<section class="brev" id="brev" aria-labelledby="brev-titel">
  <h2 class="sektion-titel" id="brev-titel" data-vis>{b.overskrift}</h2>
  <div class="brev-opslag">
    <Foto
      billede={b.billede}
      forhold="1 / 1"
      sizes="(min-width: 1000px) 420px, 92vw"
      class="brev-foto"
      data-vis
    />
    <article class="brev-papir" data-vis>
      {
        visUdkast && (
          <p class="udkast-note">
            Udkast · kun synligt, når du kører siden lokalt. Sæt <code>godkendt: true</code> i
            src/indhold.ts, når brevet er klar.
          </p>
        )
      }
      <p class="brev-hilsen">{b.hilsen}</p>
      {
        afsnit.map((a) => (
          <p>
            <Linjer tekst={a} />
          </p>
        ))
      }
      {b.afslutning && <p class="brev-afslutning"><Linjer tekst={b.afslutning} /></p>}
      <p class="brev-underskrift">{b.underskrift}</p>
      {b.ps && <p class="brev-ps"><Linjer tekst={b.ps} /></p>}
    </article>
  </div>
</section>
