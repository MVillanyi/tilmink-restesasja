---
import { indhold } from '../indhold';
import Foto from './Foto.astro';
const a = indhold.album;
---

<section class="album" id="album" aria-labelledby="album-titel">
  <h2 class="sektion-titel" id="album-titel" data-vis>{a.overskrift}</h2>
  <div class="album-gitter">
    {
      a.billeder.map((b, i) => (
        <Foto
          billede={b}
          forhold="4 / 5"
          sizes="(min-width: 1000px) 460px, 86vw"
          class={`album-foto album-foto--${(i % 4) + 1} print`}
          data-vis
        />
      ))
    }
  </div>
</section>
