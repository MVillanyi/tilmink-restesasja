---
import { indhold } from '../indhold';
import Foto from './Foto.astro';
const a = indhold.album;
// Albummet skifter mellem nogle få formater, så det ikke ligner et gitter.
const formater = ['4 / 5', '3 / 4', '3 / 4', '4 / 5'];
---

<section class="album" id="album" aria-labelledby="album-titel">
  <h2 class="sektion-titel" id="album-titel" data-vis>{a.overskrift}</h2>
  <div class="album-gitter">
    {
      a.billeder.map((b, i) => (
        <Foto
          billede={b}
          forhold={formater[i % formater.length]}
          sizes="(min-width: 1000px) 520px, (min-width: 600px) 50vw, 92vw"
          class={`album-foto album-foto--${(i % 4) + 1}`}
          data-vis
        />
      ))
    }
  </div>
</section>
